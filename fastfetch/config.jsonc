{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",        // Logo type: auto, builtin, small, file, etc.
    "source": "/home/dreamhunter/Documents/art/image/kaglorp.png",      // Built-in logo name or file path
    "width": 38,           // Width in characters
    "height": 18,          // Height in characters
},
  "display": {
    "separator": " >> ",     // Separator between keys and values
    "color": {
        "keys": "blue",    // Key color
        "title": "red"     // Title color
    },
    "key": {
        "type": "icon"   // string, icon, both, or none
    },
    "bar": {
        "width": 10,       // Width of percentage bars
        "char": {
            "elapsed": "■", // Character for elapsed portion
            "total": "-",    // Character for total portion
        },
    },
    "percent": {
        "type": 9,         // 1=number, 2=bar, 3=both, 9=colored number
        "color": {
            "green": "green",
            "yellow": "light_yellow",
            "red": "light_red"
        }
    }
},
  "modules": [
    "title",
    "separator",
    "os",
    "break",
    "host",
    "break",
    "kernel",
    "break",
    "uptime",
    "break",
    "terminalfont",
    "separator",
    "cpu",
    "break",
    "gpu",
    "break",
    "memory",
    "break",
    "poweradapter",
  ]
}
